[Unit]
Description=Arizona power outage archive collector (scrape + commit + push)
Documentation=https://github.com/vmanam1/az-power-outage-archive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=leaps-admin
WorkingDirectory=/home/leaps-admin/az-power-outage-archive
# venv interpreter so the pinned selenium/requests are used
Environment=PYTHON=/home/leaps-admin/az-power-outage-archive/venv/bin/python
# Private, uncommitted overrides (e.g. HEALTHCHECK_URL for the dead-man's-switch
# ping). Leading "-" makes it optional so the unit still starts if absent.
EnvironmentFile=-/etc/default/outage-archive
ExecStart=/bin/bash /home/leaps-admin/az-power-outage-archive/scripts/collect.sh
# One provider (navopache) can hang ~3 min on retries when its upstream is
# down; give the whole run generous headroom before systemd kills it.
TimeoutStartSec=600
