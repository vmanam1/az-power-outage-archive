[Unit]
Description=Hourly trigger for the Arizona power outage archive collector

[Timer]
# Fire at minute :07 of every hour, matching the previous GitHub Actions cron.
OnCalendar=*-*-* *:07:00
# If the Pi was off/asleep when a run was due, run once as soon as it is back.
Persistent=true
# Small random delay so the run does not stampede the providers exactly on :07.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
